{
  "name": "@reachforstar/dsh-tool-excalidraw-copy",
  "description": "Model-facing Excalidraw scene tools (read, write, draw, export) over a workspace scene file",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
